async function createCategory() {
  const name = newCategoryName.trim();

  if (!name) {
    toast.error("Vui lÃƒÂ²ng nhÃ¡ÂºÂ­p tÃƒÂªn danh mÃ¡Â»Â¥c.");
    return;
  }

  if (categoryModalMode === "child" && !parentCategoryId) {
    toast.error("HÃƒÂ£y chÃ¡Â»Ân danh mÃ¡Â»Â¥c cha trÃ†Â°Ã¡Â»â€ºc.");
    return;
  }

  try {
    setCreatingCategory(true);

    let duplicateQuery = supabase
      .from("categories")
      .select("id,name,parent_id")
      .eq("name", name);

    duplicateQuery =
      categoryModalMode === "child"
        ? duplicateQuery.eq("parent_id", parentCategoryId)
        : duplicateQuery.is("parent_id", null);

    const { data: duplicate, error: duplicateError } =
      await duplicateQuery.maybeSingle();

    if (duplicateError) throw duplicateError;

    if (duplicate) {
      toast.error("Danh mÃ¡Â»Â¥c nÃƒÂ y Ã„â€˜ÃƒÂ£ tÃ¡Â»â€œn tÃ¡ÂºÂ¡i.");
      return;
    }

    const slug = createSlug(name);

    const { data: sameSlug, error: slugError } = await supabase
      .from("categories")
      .select("id")
      .eq("slug", slug)
      .maybeSingle();

    if (slugError) throw slugError;

    if (sameSlug) {
      toast.error("Slug Ã„â€˜ÃƒÂ£ tÃ¡Â»â€œn tÃ¡ÂºÂ¡i. HÃƒÂ£y dÃƒÂ¹ng tÃƒÂªn khÃƒÂ¡c.");
      return;
    }

    const { data: created, error } = await supabase
      .from("categories")
      .insert({
        name,
        slug,
        parent_id:
          categoryModalMode === "child"
            ? parentCategoryId
            : null,
      })
      .select("*")
      .single();

    if (error) throw error;

    setCategories((current) =>
      [...current, created].sort((a, b) =>
        a.name.localeCompare(b.name)
      )
    );

    if (categoryModalMode === "child") {
      setCategoryId(created.id);
    } else {
      setParentCategoryId(created.id);
      setCategoryId("");
    }

    setCategoryModalOpen(false);
    setNewCategoryName("");

    toast.success(
      categoryModalMode === "child"
        ? `Ã„ÂÃƒÂ£ tÃ¡ÂºÂ¡o danh mÃ¡Â»Â¥c con "${name}".`
        : `Ã„ÂÃƒÂ£ tÃ¡ÂºÂ¡o danh mÃ¡Â»Â¥c chÃƒÂ­nh "${name}".`
    );
  } catch (error: any) {
    toast.error(
      error?.message || "KhÃƒÂ´ng thÃ¡Â»Æ’ tÃ¡ÂºÂ¡o danh mÃ¡Â»Â¥c."
    );
  } finally {
    setCreatingCategory(false);
  }
}

async function deleteCategory(categoryIdToDelete: string) {
  const category = categories.find(
    (item) => item.id === categoryIdToDelete
  );

  if (!category) return;

  const confirmed = window.confirm(
    `BÃ¡ÂºÂ¡n cÃƒÂ³ chÃ¡ÂºÂ¯c muÃ¡Â»â€˜n xÃƒÂ³a danh mÃ¡Â»Â¥c "${category.name}"?`
  );

  if (!confirmed) return;

  try {
    setDeletingCategoryId(categoryIdToDelete);

    const { count: childCount, error: childError } = await supabase
      .from("categories")
      .select("id", { count: "exact", head: true })
      .eq("parent_id", categoryIdToDelete);

    if (childError) throw childError;

    if ((childCount ?? 0) > 0) {
      toast.error(
        `KhÃƒÂ´ng thÃ¡Â»Æ’ xÃƒÂ³a "${category.name}" vÃƒÂ¬ danh mÃ¡Â»Â¥c nÃƒÂ y vÃ¡ÂºÂ«n cÃƒÂ²n danh mÃ¡Â»Â¥c con.`
      );
      return;
    }

    const { count: productCount, error: productError } = await supabase
      .from("products")
      .select("id", { count: "exact", head: true })
      .eq("category_id", categoryIdToDelete);

    if (productError) throw productError;

    if ((productCount ?? 0) > 0) {
      toast.error(
        `KhÃƒÂ´ng thÃ¡Â»Æ’ xÃƒÂ³a "${category.name}" vÃƒÂ¬ Ã„â€˜ang cÃƒÂ³ ${productCount} sÃ¡ÂºÂ£n phÃ¡ÂºÂ©m sÃ¡Â»Â­ dÃ¡Â»Â¥ng danh mÃ¡Â»Â¥c nÃƒÂ y. HÃƒÂ£y chuyÃ¡Â»Æ’n sÃ¡ÂºÂ£n phÃ¡ÂºÂ©m sang danh mÃ¡Â»Â¥c khÃƒÂ¡c trÃ†Â°Ã¡Â»â€ºc.`
      );
      return;
    }

    const { error: deleteError } = await supabase
      .from("categories")
      .delete()
      .eq("id", categoryIdToDelete);

    if (deleteError) throw deleteError;

    setCategories((current) =>
      current.filter((item) => item.id !== categoryIdToDelete)
    );

    if (parentCategoryId === categoryIdToDelete) {
      setParentCategoryId("");
      setCategoryId("");
    }

    if (categoryId === categoryIdToDelete) {
      setCategoryId("");
    }

    toast.success(`Ã„ÂÃƒÂ£ xÃƒÂ³a danh mÃ¡Â»Â¥c "${category.name}".`);
  } catch (error: any) {
    toast.error(error?.message || "KhÃƒÂ´ng thÃ¡Â»Æ’ xÃƒÂ³a danh mÃ¡Â»Â¥c.");
  } finally {
    setDeletingCategoryId(null);
  }
}

function createSlug(text: string) {
  return text
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/Ã„â€˜/g, "d")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

