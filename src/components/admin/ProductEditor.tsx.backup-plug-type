async function uploadThumbnail(
  e: React.ChangeEvent<HTMLInputElement>
) {
  const input = e.currentTarget;
  const file = input.files?.[0];

  if (!file) return;

  if (!file.type.startsWith("image/")) {
    toast.error("Vui lÃƒÂ²ng chÃ¡Â»Ân file hÃƒÂ¬nh Ã¡ÂºÂ£nh.");
    input.value = "";
    return;
  }

  if (file.size > 10 * 1024 * 1024) {
    toast.error("Ã¡ÂºÂ¢nh khÃƒÂ´ng Ã„â€˜Ã†Â°Ã¡Â»Â£c vÃ†Â°Ã¡Â»Â£t quÃƒÂ¡ 10MB.");
    input.value = "";
    return;
  }

  try {
    const formData = new FormData();
    formData.append("file", file);
    formData.append("productId", product.id);

    const response = await fetch("/api/upload-r2", {
      method: "POST",
      body: formData,
    });

    const result = await response.json();

    if (!response.ok || !result.success || !result.url) {
      throw new Error(
        result.error ||
          result.detail ||
          "Upload Ã¡ÂºÂ£nh lÃƒÂªn Cloudflare R2 thÃ¡ÂºÂ¥t bÃ¡ÂºÂ¡i."
      );
    }

    setImageUrl(result.url);
    toast.success("Ã„ÂÃƒÂ£ tÃ¡ÂºÂ£i Ã¡ÂºÂ£nh lÃƒÂªn Cloudflare R2.");
  } catch (error: any) {
    toast.error(
      error?.message || "Upload Ã¡ÂºÂ£nh thÃ¡ÂºÂ¥t bÃ¡ÂºÂ¡i."
    );
  } finally {
    input.value = "";
  }
}

