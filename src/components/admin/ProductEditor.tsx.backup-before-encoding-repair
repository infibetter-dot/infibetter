async function uploadThumbnail(
  e: React.ChangeEvent<HTMLInputElement>
) {
  const input = e.currentTarget;
  const file = input.files?.[0];

  if (!file) return;

  if (!file.type.startsWith("image/")) {
    toast.error("Vui lÃƒÆ’Ã‚Â²ng chÃƒÂ¡Ã‚Â»Ã‚Ân file hÃƒÆ’Ã‚Â¬nh ÃƒÂ¡Ã‚ÂºÃ‚Â£nh.");
    input.value = "";
    return;
  }

  if (file.size > 10 * 1024 * 1024) {
    toast.error("ÃƒÂ¡Ã‚ÂºÃ‚Â¢nh khÃƒÆ’Ã‚Â´ng Ãƒâ€žÃ¢â‚¬ËœÃƒâ€ Ã‚Â°ÃƒÂ¡Ã‚Â»Ã‚Â£c vÃƒâ€ Ã‚Â°ÃƒÂ¡Ã‚Â»Ã‚Â£t quÃƒÆ’Ã‚Â¡ 10MB.");
    input.value = "";
    return;
  }

  try {
    const formData = new FormData();
    formData.append("file", file);
    formData.append("productId", product.id);

    const response = await fetch("/api/upload-r2", {
      method: "POST",
      body: formData,
    });

    const result = await response.json();

    if (!response.ok || !result.success || !result.url) {
      throw new Error(
        result.error ||
          result.detail ||
          "Upload ÃƒÂ¡Ã‚ÂºÃ‚Â£nh lÃƒÆ’Ã‚Âªn Cloudflare R2 thÃƒÂ¡Ã‚ÂºÃ‚Â¥t bÃƒÂ¡Ã‚ÂºÃ‚Â¡i."
      );
    }

    setImageUrl(result.url);
    toast.success("Ãƒâ€žÃ‚ÂÃƒÆ’Ã‚Â£ tÃƒÂ¡Ã‚ÂºÃ‚Â£i ÃƒÂ¡Ã‚ÂºÃ‚Â£nh lÃƒÆ’Ã‚Âªn Cloudflare R2.");
  } catch (error: any) {
    toast.error(
      error?.message || "Upload ÃƒÂ¡Ã‚ÂºÃ‚Â£nh thÃƒÂ¡Ã‚ÂºÃ‚Â¥t bÃƒÂ¡Ã‚ÂºÃ‚Â¡i."
    );
  } finally {
    input.value = "";
  }
}

