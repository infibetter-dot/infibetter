async function createCategory() {
  const name = newCategoryName.trim();

  if (!name) {
    toast.error("Vui lÃƒÆ’Ã‚Â²ng nhÃƒÂ¡Ã‚ÂºÃ‚Â­p tÃƒÆ’Ã‚Âªn danh mÃƒÂ¡Ã‚Â»Ã‚Â¥c.");
